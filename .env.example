# Application
NODE_ENV=development
PORT=3000
APP_NAME=nestjs-boilerplate
API_PREFIX=api

# Database (optional — TypeORM module only loads when set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_boilerplate
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Observe (optional — module only loads when all three are set)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=