# Application
NODE_ENV=development
APP_NAME=nestjs-boiler-plate
# Absolute base url, no trailing slash. Every link in an email is built from it.
# Required, and must be https, in production.
APP_URL=http://localhost:3000
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_boiler_plate

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

# Two-factor authentication
TWO_FACTOR_ENABLED=true
# Encrypts the TOTP secret at rest, derived with sha256, so any passphrase works.
# Rotating it invalidates every stored secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# A value from the placeholder list is rejected at boot in production, because a
# key that is in this repository is not a secret.
TWO_FACTOR_ENCRYPTION_KEY=dev-only-2fa-key-generate-your-own
# Shown as the account name in the authenticator app.
TWO_FACTOR_ISSUER='NestJS Boilerplate'

# Cache
# redis, valkey, or memory. memory is for local development only.
CACHE_BACKEND=redis
# One connection string, including credentials, TLS and database. Valkey uses
# the same scheme, for example rediss://default:password@host:port/0
CACHE_URL=redis://localhost:6379/0
# Namespace applied to every key, so one database can host several apps.
CACHE_KEY_PREFIX=nestjs_boiler_plate
# Default entry lifetime in seconds.
CACHE_DEFAULT_TTL=300
# Lifetime of a "not found" answer, kept short on purpose.
CACHE_EMPTY_TTL=10
# How long to wait for the cache before giving up, in milliseconds.
CACHE_CONNECT_TIMEOUT=2000
# Lifetime of a user's cached authentication claims.
# A backstop, not the mechanism: the write that deactivates, demotes or revokes
# drops the entry, so this only bounds how long a missed invalidation could hide
# a change. Configurable because that window is a security property.
CACHE_AUTH_USER_TTL=60
# Lifetime of a role's cached permission names. Longer than the claims because
# there is one entry per role rather than one per user.
CACHE_AUTH_ROLE_TTL=600

# Redis for the queue and the shared throttler
# Kept apart from the cache because their lifetimes differ: a cache entry is
# disposable, while a queue job, a rate-limit counter and a revoked-token marker
# must not be swept away. Same server is fine, different namespace is not
# optional. Database 1 keeps it clear of the cache on database 0.
# Used by the queue (dedupe keys, dead-letter list) and a future shared throttler
# store. Falls back to this when QUEUE_REDIS_URL is unset. The cache above uses a
# different key prefix on purpose, so a cache sweep never evicts a queue job.
REDIS_URL=redis://localhost:6379/1
# Must differ from CACHE_KEY_PREFIX; a cache sweep would evict queue jobs.
REDIS_KEY_PREFIX=nestjs_boiler_plate:redis
REDIS_CONNECT_TIMEOUT=2000
# Keep on, so a redis outage costs a miss rather than every request in flight
# waiting on a socket that is not coming back.
REDIS_DISABLE_OFFLINE_QUEUE=true

# Mail
# memory, smtp, ses, or sendgrid. Each provider package is optional, so a
# provider needs both its npm install and this flag. memory keeps messages in
# memory and delivers nothing, and is refused in production.
MAIL_TRANSPORT=memory
# Required in production. A wrong value here sends a password reset token to
# whichever deployment the address belongs to.
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME='NestJS Boilerplate'
MAIL_REPLY_TO=
# Optional prefix on the subject line, so the app is identifiable in a mailbox.
MAIL_SUBJECT_PREFIX=
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=587
# Leave unset to infer from the port: 465 is implicit TLS, 587 is STARTTLS.
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SENDGRID_API_KEY=
MAIL_SES_REGION=
MAIL_CONNECTION_TIMEOUT=10000
MAIL_SOCKET_TIMEOUT=30000

# Notifications
# No channel needs a package. The master switch overrides every channel, so an
# incident can be silenced without editing four variables.
NOTIFICATION_ENABLED=false
# On by default, so a fresh clone shows what the app would have sent.
NOTIFICATION_CONSOLE_ENABLED=true
NOTIFICATION_TIMEOUT=5000
NOTIFICATION_RETRIES=2
NOTIFICATION_RETRY_DELAY=1000
# Keep off: a broken webhook must never fail the request that triggered it.
NOTIFICATION_THROW_ON_FAILURE=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum topic, to route event types to separate rooms.
TELEGRAM_TOPIC_ID=

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL=

# Background queue
# bullmq is optional. With the queue off, the same processors run in process, so
# turning it on is an npm install plus this flag and not a code change.
QUEUE_ENABLED=false
# Falls back to REDIS_URL. Required when the queue is on.
QUEUE_REDIS_URL=
# Separate from the cache prefix for the same reason: a TTL sweep must not
# expire a job that is still due.
QUEUE_PREFIX=nestjs_boiler_plate:queue
# Discard a job that has waited longer than this, in milliseconds.
QUEUE_JOB_TIMEOUT=300000
QUEUE_RETRY_ATTEMPTS=5
QUEUE_RETRY_DELAY=1000
QUEUE_RETRY_MAX_DELAY=60000
QUEUE_CONCURRENCY_MAIL=5
QUEUE_CONCURRENCY_NOTIFICATION=5
# One at a time: it is batch work with nobody waiting on it.
QUEUE_CONCURRENCY_MAINTENANCE=1
QUEUE_CONCURRENCY_DIGEST=2
QUEUE_REMOVE_COMPLETE_AFTER=3600000
QUEUE_REMOVE_FAIL_AFTER=86400000
# Keep on, or a disabled queue would silently drop mail instead of sending it.
QUEUE_IN_PROCESS_FALLBACK=true
QUEUE_IN_PROCESS_CONCURRENCY=5

# Data retention
# On by default: it only removes rows already past their age, so a deployment
# that never configures it loses nothing it could still use. Set false to stop
# it entirely. Every age is at least one day: a zero means "delete everything
# older than now", which turns a typo into data loss.
RETENTION_ENABLED=true
# Turn on for the first production run: reports what would be deleted, deletes
# nothing.
RETENTION_DRY_RUN=false
RETENTION_SCHEDULE='17 3 * * *'
# Small enough that a batch does not show up as latency.
RETENTION_BATCH_SIZE=5000
RETENTION_BATCH_DELAY=100
RETENTION_RUN_TIMEOUT=3600000
RETENTION_USERS_DAYS=30
RETENTION_EMAIL_TOKENS_DAYS=7
RETENTION_RESET_TOKENS_DAYS=7
RETENTION_REFRESH_TOKENS_DAYS=7
RETENTION_MAIL_LOGS_DAYS=30
RETENTION_NOTIFICATION_LOGS_DAYS=30
RETENTION_LOGIN_ATTEMPTS_DAYS=7
# Longer than the rest on purpose: a month of audit logs is not an audit trail.
RETENTION_AUDIT_LOGS_DAYS=365

# Password policy
# The defaults match the @MinLength(8) the auth DTOs enforce today, so nothing
# changes before those read this namespace.
PASSWORD_MIN_LENGTH=8
# scrypt hashes the whole input, so this is a bound on hashing work rather than
# a length the algorithm stops reading at.
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
# How many previous passwords are kept and rejected on reuse.
PASSWORD_HISTORY_COUNT=5
# Off by default: it is a network call in the request path. Uses the
# k-anonymity API, so the password itself never leaves the server.
PASSWORD_CHECK_BREACH_LIST=false
# 0 disables the lockout.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15

# Security headers (helmet)
SECURITY_ENABLED=true
# Leave off while the Swagger UI is served, since it needs inline scripts.
SECURITY_CONTENT_SECURITY_POLICY=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_REFERRER_POLICY=no-referrer

# CORS. Leave CORS_ORIGINS empty for same-origin only, which is the right
# default for an API that is not called from a browser.
CORS_ORIGINS=
# Needed for cookies, not for an Authorization header. Requires an explicit
# allow-list above; a wildcard is rejected in production.
CORS_CREDENTIALS=false
CORS_MAX_AGE=86400

# Rate limiting, applied globally and tightened per route with @Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_BLOCK_DURATION=0

# Seed
# There is no default on purpose: a seeded account with a published password is
# a published account. At least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE='NestJS Boilerplate API'
SWAGGER_DESCRIPTION='Production-ready NestJS boilerplate API documentation'
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Observe
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
OBSERVE_SERVICE_ID=nestjs-boiler-plate