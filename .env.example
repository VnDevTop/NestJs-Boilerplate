NODE_ENV=development
PORT=3000
APP_NAME=nestjs-boilerplate
API_PREFIX=api

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_boilerplate
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

REDIS_URL=
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CACHE_TTL=60000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SECURE=false

HTTP_TIMEOUT=5000
HTTP_MAX_REDIRECTS=5

# Resilience
RESILIENCE_RETRY_ATTEMPTS=3
RESILIENCE_TIMEOUT_MS=5000
RESILIENCE_CB_FAILURE_RATE=50
RESILIENCE_CB_OPEN_DURATION=30s
RESILIENCE_BULKHEAD_CONCURRENCY=10
RESILIENCE_BULKHEAD_QUEUE=10

# Idempotency
IDEMPOTENCY_HEADER=Idempotency-Key
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_TTL=60s

SWAGGER_TITLE=NestJS Boilerplate API
SWAGGER_DESCRIPTION=Production-ready NestJS boilerplate API
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

I18N_FALLBACK_LANGUAGE=en
I18N_SUPPORTED_LANGUAGES=en