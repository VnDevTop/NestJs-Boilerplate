{
  "name": "nestjs-boilerplate",
  "version": "0.0.1",
  "description": "A production-ready NestJS boilerplate with TypeScript, Vitest, Oxlint, and GitHub Actions.",
  "author": "VnDev.Top <hi@vndev.top>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/observe": "^0.3.19",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "contributors": [
    "VnDev.Top <hi@vndev.top>",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VnDevTop/nestjs-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/VnDevTop/nestjs-boilerplate/issues"
  },
  "homepage": "https://github.com/VnDevTop/nestjs-boilerplate#readme",
  "keywords": [
    "nestjs",
    "boilerplate",
    "typescript",
    "vitest",
    "oxlint",
    "docker"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
