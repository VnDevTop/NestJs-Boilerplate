{
  "uid": "nestjs-boilerplate-ops",
  "title": "NestJS Boilerplate — operations",
  "description": "Auth failure rate, job lag and mail delivery. One row per thing a deployment gets paged about; the runbook link on each panel is the next step when one turns red.",
  "tags": ["nestjs", "boilerplate"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/VnDevTop/NestJs-Boilerplate/blob/master/docs/runbook.md"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Authentication",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sign-in failures per minute",
      "description": "Failures include every wrong password against every address, registered or not — which is the point. A rising line here against a flat success line is somebody guessing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(auth_login_attempts_total{outcome=\"failure\"}[5m])) * 60",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failure ratio",
      "description": "Failures over all attempts. The denominator is clamped so a deployment with no traffic sits at zero rather than dividing by zero on the way up from it.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(auth_login_attempts_total{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(auth_login_attempts_total[5m])), 0.001)",
          "legendFormat": "failure ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Mail",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Delivery rate by transport",
      "description": "Split by permanence on the failures: a 4xx will never succeed on retry, so it is a credential problem and not a capacity one.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport) (rate(mail_sent_total[5m]))",
          "legendFormat": "sent · {{transport}}"
        },
        {
          "refId": "B",
          "expr": "sum by (permanent) (rate(mail_failures_total[5m]))",
          "legendFormat": "failed · permanent={{permanent}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mail failure ratio",
      "description": "The same expression the MailFailing alert fires on, so a red line here is a page that is about to arrive — or already has.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mail_failures_total[5m])) / clamp_min(sum(rate(mail_sent_total[5m])) + sum(rate(mail_failures_total[5m])), 1)",
          "legendFormat": "failure ratio"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job lag (p95)",
      "description": "Seconds between a job being accepted and a worker picking it up. Buckets stop at 600s because ten minutes is already an incident.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(job_lag_seconds_bucket[5m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Backlog by queue",
      "description": "Per queue, because the config gives each one its own concurrency and mail being slow is not maintenance being slow.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "queue_backlog",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Dead-lettered jobs",
      "description": "Jobs that exhausted their retries and will not run again. Anything above zero is a piece of work that did not happen.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dead_lettered_total",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Maintenance age (hours)",
      "description": "Hours since the last retention run finished. The alert fires at 26.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 24 },
              { "color": "red", "value": 26 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "maintenance_age_hours", "legendFormat": "age" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Rows deleted by retention (24h)",
      "description": "Per target. Zero on a target that normally deletes is a target that stopped working, which is different from a target with nothing to delete.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(retention_rows_deleted_total[24h])",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Notifications delivered (1h)",
      "description": "By event and channel. A channel that has gone quiet while the others carry on is a channel that is misconfigured, not one that is unused.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 27 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, delivered) (increase(notification_sent_total[1h]))",
          "legendFormat": "{{channel}} delivered={{delivered}}"
        }
      ]
    }
  ]
}
